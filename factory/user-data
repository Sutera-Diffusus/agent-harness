#cloud-config
# ═══════════════════════════════════════════════════════════════
#  SV8 出厂 U 盘 · Ubuntu Desktop 无人值守安装配置
#  放 U 盘 /nocloud/ 下，grub 加 autoinstall 参数后插机即装
#  默认账号 sv8 / 密码 sv8admin（装完请改）
# ═══════════════════════════════════════════════════════════════
autoinstall:
  version: 1
  interactive-sections: []
  locale: zh_CN.UTF-8
  keyboard: {layout: us, toggle: null, variant: ''}
  timezone: Asia/Shanghai
  identity:
    hostname: sv8
    username: sv8
    realname: sv8
    password: "$6$luILHXywQU26XVSC$kvEuj7TMKOQwzkKy.8xD1VCWEZv/DiZ1.CV3K8SOl7xHRJAMGMJO9sOFiku.A2WON4Gv6YmaF4dxKtoXS1SnR0"
  ssh:
    install-server: true
    allow-pw: true
  network:
    version: 2
    ethernets:
      all-en:
        match: {name: "en*"}
        dhcp4: true
      all-eth:
        match: {name: "eth*"}
        dhcp4: true
  storage:
    config:
      - {type: disk, id: disk0, ptable: gpt, wipe: superblock-recursive, grub_device: true}
      - {type: partition, id: part-efi, device: disk0, size: 512M, wipe: superblock, flag: boot, number: 1}
      - {type: partition, id: part-root, device: disk0, size: -1, wipe: superblock, number: 2}
      - {type: format, id: fmt-efi, volume: part-efi, fstype: fat32}
      - {type: format, id: fmt-root, volume: part-root, fstype: btrfs}
      - {type: mount, id: m-root, device: fmt-root, path: /}
      - {type: mount, id: m-efi, device: fmt-efi, path: /boot/efi}
  packages:
    - curl
    - unzip
    - git
    - python3
    - build-essential
  late-commands:
    # 把 U 盘里的出厂包拷进新系统并跑部署
    - cp -r /cdrom/bundle /target/opt/sv8-bundle || true
    - chmod +x /target/opt/sv8-bundle/late-setup.sh || true
    - curtin in-target -- /opt/sv8-bundle/late-setup.sh || true
  shutdown: reboot
